{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"${CLAUDE_PLUGIN_ROOT}/hooks/analysis-contract-injector.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/analysis-contract-injector.py\"",
            "timeout": 3,
            "statusMessage": "Checking llm-accuracy analysis contract"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"${CLAUDE_PLUGIN_ROOT}/hooks/fusion-evidence-trigger.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/fusion-evidence-trigger.py\"",
            "timeout": 3,
            "statusMessage": "Checking llm-accuracy fusion evidence"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"${CLAUDE_PLUGIN_ROOT}/hooks/post-compact-accuracy.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/post-compact-accuracy.py\"",
            "timeout": 3,
            "statusMessage": "Checking llm-accuracy post-compaction accuracy"
          }
        ]
      }
    ]
  }
}
