{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -- \"analysis-contract-injector.py\"; (. \"${CLAUDE_PLUGIN_ROOT}/hooks/python-launcher.cmd\" \"analysis-contract-injector.py\"); exit 0",
            "timeout": 10,
            "statusMessage": "Checking llm-accuracy analysis contract"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -- \"fusion-evidence-trigger.py\"; (. \"${CLAUDE_PLUGIN_ROOT}/hooks/python-launcher.cmd\" \"fusion-evidence-trigger.py\"); exit 0",
            "timeout": 10,
            "statusMessage": "Checking llm-accuracy fusion evidence"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -- \"claim-fidelity-trigger.py\"; (. \"${CLAUDE_PLUGIN_ROOT}/hooks/python-launcher.cmd\" \"claim-fidelity-trigger.py\"); exit 0",
            "timeout": 10,
            "statusMessage": "Checking llm-accuracy claim fidelity"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(mcp__.*|Bash|Read)$",
        "hooks": [
          {
            "type": "command",
            "command": "set -- \"partial-result-sentinel.py\"; (. \"${CLAUDE_PLUGIN_ROOT}/hooks/python-launcher.cmd\" \"partial-result-sentinel.py\"); exit 0",
            "timeout": 10,
            "statusMessage": "Checking llm-accuracy partial result signal"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "set -- \"post-compact-accuracy.py\"; (. \"${CLAUDE_PLUGIN_ROOT}/hooks/python-launcher.cmd\" \"post-compact-accuracy.py\"); exit 0",
            "timeout": 10,
            "statusMessage": "Checking llm-accuracy post-compaction accuracy"
          }
        ]
      }
    ]
  }
}
