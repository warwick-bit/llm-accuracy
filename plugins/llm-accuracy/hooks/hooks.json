{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_executable}",
            "timeout": 10,
            "statusMessage": "Checking llm-accuracy analysis contract",
            "args": [
              "-c",
              "import os,runpy,sys; p=sys.argv.pop(1); runpy.run_path(p,run_name='__main__') if os.path.isfile(p) else None",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_runner.py",
              "analysis-contract-injector.py"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_executable}",
            "timeout": 10,
            "statusMessage": "Checking llm-accuracy fusion evidence",
            "args": [
              "-c",
              "import os,runpy,sys; p=sys.argv.pop(1); runpy.run_path(p,run_name='__main__') if os.path.isfile(p) else None",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_runner.py",
              "fusion-evidence-trigger.py"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_executable}",
            "timeout": 10,
            "statusMessage": "Checking llm-accuracy claim fidelity",
            "args": [
              "-c",
              "import os,runpy,sys; p=sys.argv.pop(1); runpy.run_path(p,run_name='__main__') if os.path.isfile(p) else None",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_runner.py",
              "claim-fidelity-trigger.py"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(mcp__.*|Bash|Read)$",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_executable}",
            "timeout": 10,
            "statusMessage": "Checking llm-accuracy partial result signal",
            "args": [
              "-c",
              "import os,runpy,sys; p=sys.argv.pop(1); runpy.run_path(p,run_name='__main__') if os.path.isfile(p) else None",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_runner.py",
              "partial-result-sentinel.py"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_executable}",
            "timeout": 10,
            "statusMessage": "Checking llm-accuracy post-compaction accuracy",
            "args": [
              "-c",
              "import os,runpy,sys; p=sys.argv.pop(1); runpy.run_path(p,run_name='__main__') if os.path.isfile(p) else None",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_runner.py",
              "post-compact-accuracy.py"
            ]
          }
        ]
      }
    ]
  }
}
