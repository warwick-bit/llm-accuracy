{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_executable}",
            "timeout": 10,
            "args": [
              "-c",
              "import os,runpy,sys; p=sys.argv.pop(1); runpy.run_path(p,run_name='__main__') if os.path.isfile(p) else None",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_runner.py",
              "memory.py",
              "hook-capture",
              "--plugin-data",
              "${CLAUDE_PLUGIN_DATA}"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
