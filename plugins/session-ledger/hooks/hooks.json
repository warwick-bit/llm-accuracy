{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-ledger.py",
              "capture",
              "--plugin-data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-ledger.py",
              "capture",
              "--plugin-data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-ledger.py",
              "pre-compact",
              "--plugin-data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-ledger.py",
              "post-compact",
              "--plugin-data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-ledger.py",
              "session-start",
              "--plugin-data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
